{
  "compilerOptions": {
    "target": "ES2020",

    "module": "ESNext",

    "moduleResolution": "Bundler",

    "lib": ["ES2020", "DOM"],

    "types": ["node"],

    "strict": true,

    "jsx": "preserve",

    "resolveJsonModule": true,

    "isolatedModules": true,

    "esModuleInterop": true,

    "skipLibCheck": true
  }
}